    <header>
        <h1>🏆 SB Sports Co</h1>
        <div class="sync-status">Local Storage</div>
    </header>

    <div class="tabs">
        <button class="tab active" onclick="switchTab('dashboard')">Dashboard</button>
        <button class="tab" onclick="switchTab('analytics')">Analytics</button>
        <button class="tab" onclick="switchTab('add-card')">Add Card</button>
        <button class="tab" onclick="switchTab('sell-card')">Sell Card</button>
        <button class="tab" onclick="switchTab('inventory')">Inventory</button>
    </div>

    <div id="dashboard" class="tab-content active">
        <h2>Dashboard</h2>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value" id="stat-inventory">0</div>
                <div class="stat-label">In Inventory</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="stat-grading">0</div>
                <div class="stat-label">Grading</div>
            </div>
            <div class="stat-card">
                <div class="stat-value" id="stat-sold">0</div>
                <div class="stat-label">Sold</div>
            </div>
        </div>
        <div>
            <h3>Recent Activity</h3>
            <div id="recent-cards" class="card-grid"></div>
        </div>
    </div>

    <div id="analytics" class="tab-content">
        <h2>Analytics & Financial Reports</h2>
        
        <div class="filter-section" style="margin-bottom: 30px;">
            <select id="analytics-timeframe" onchange="updateAnalytics()">
                <option value="all">All Time</option>
                <option value="today">Today</option>
                <option value="week">This Week</option>
                <option value="month">This Month</option>
                <option value="year">This Year</option>
            </select>
        </div>

        <div class="stats-grid">
            <div class="stat-card" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                <div class="stat-value" id="total-revenue">$0</div>
                <div class="stat-label">Total Revenue</div>
            </div>
            <div class="stat-card" style="background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);">
                <div class="stat-value" id="total-expenses">$0</div>
                <div class="stat-label">Total Expenses</div>
            </div>
            <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="stat-value" id="net-profit">$0</div>
                <div class="stat-label">Net Profit</div>
            </div>
            <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="stat-value" id="roi-percentage">0%</div>
                <div class="stat-label">ROI</div>
            </div>
        </div>

        <div style="background: white; padding: 25px; border-radius: 8px; margin-bottom: 20px; border: 2px solid #dee2e6;">
            <h3 style="margin-bottom: 20px;">Sales Performance</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;">
                <div>
                    <h4 style="color: #ff6b35; margin-bottom: 10px;">Sales Metrics</h4>
                    <div class="card-detail">Total Sales: <strong id="total-sales-count">0</strong></div>
                    <div class="card-detail">Average Sale: <strong id="avg-sale-price">$0</strong></div>
                    <div class="card-detail">Highest Sale: <strong id="highest-sale">$0</strong></div>
                </div>
                <div>
                    <h4 style="color: #ff6b35; margin-bottom: 10px;">Inventory Value</h4>
                    <div class="card-detail">Cards: <strong id="current-inventory-count">0</strong></div>
                    <div class="card-detail">Invested: <strong id="total-invested">$0</strong></div>
                </div>
            </div>
        </div>
    </div>

    <div id="add-card" class="tab-content">
        <h2>Add Card</h2>
        
        <div class="mode-selector">
            <button class="mode-btn active" onclick="setMode('single')">Add Single Card</button>
            <button class="mode-btn" onclick="setMode('bulk')">Add Bulk Lot</button>
        </div>

        <div id="single-mode" class="form-section active">
            <form id="single-card-form" onsubmit="return addSingleCard(event)">
                <div class="form-group">
                    <label>Card Name *</label>
                    <input type="text" id="card-name" required>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Grade / Raw *</label>
                        <input type="text" id="card-grade" required>
                    </div>
                    <div class="form-group">
                        <label>Purchase Price *</label>
                        <input type="number" id="card-purchase-price" step="0.01" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Purchased From</label>
                        <input type="text" id="card-purchased-from">
                    </div>
                    <div class="form-group">
                        <label>Purchase Date</label>
                        <input type="date" id="card-purchase-date">
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Grading Fee</label>
                        <input type="number" id="card-grading-fee" step="0.01" value="0">
                    </div>
                    <div class="form-group">
                        <label>Status *</label>
                        <select id="card-status" required>
                            <option value="inventory">Inventory</option>
                            <option value="grading">Grading</option>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>Notes</label>
                    <textarea id="card-notes"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Add Card</button>
            </form>
        </div>

        <div id="bulk-mode" class="form-section">
            <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
                <div class="form-group">
                    <label>Lot Name *</label>
                    <input type="text" id="lot-name">
                </div>
                <div class="form-group">
                    <label>Total Purchase Price *</label>
                    <input type="number" id="lot-purchase-price" step="0.01">
                </div>
                <div class="form-group">
                    <label>Purchased From</label>
                    <input type="text" id="lot-purchased-from">
                </div>
            </div>

            <h3>Add Cards to Lot</h3>
            <form id="bulk-card-form" onsubmit="return addToBulkLot(event)">
                <div class="form-group">
                    <label>Card Name *</label>
                    <input type="text" id="bulk-card-name" required>
                </div>
                <div class="form-group">
                    <label>Grade / Raw *</label>
                    <input type="text" id="bulk-card-grade" required>
                </div>
                <button type="submit" class="btn btn-primary">Add to Lot</button>
            </form>

            <div style="margin-top: 20px;">
                <h3>Cards in Lot: <span id="lot-count">0</span></h3>
                <div id="lot-cards-list"></div>
                <button class="btn btn-success" id="save-lot-btn" onclick="saveBulkLot()" style="display: none;">Save Entire Lot</button>
            </div>
        </div>
    </div>

    <div id="sell-card" class="tab-content">
        <h2>Sell Card</h2>
        
        <div class="mode-selector">
            <button class="mode-btn active" onclick="setSellMode('single')">Sell Single</button>
            <button class="mode-btn" onclick="setSellMode('lot')">Sell as Lot</button>
        </div>

        <div id="sell-single-mode" class="form-section active">
            <h3>Select Card to Sell</h3>
            <div class="search-box">
                <input type="text" id="sell-search" placeholder="Search cards..." onkeyup="filterSellCards()">
            </div>
            <div id="sell-cards-container"></div>
        </div>

        <div id="sell-lot-mode" class="form-section">
            <h3>Select Multiple Cards</h3>
            <div class="search-box">
                <input type="text" id="lot-sell-search" placeholder="Search cards..." onkeyup="filterLotSellCards()">
            </div>
            <div id="lot-sell-container"></div>
            <div style="margin-top: 20px;">
                <h3>Selected: <span id="selected-count">0</span></h3>
                <div class="form-group">
                    <label>Total Sale Price *</label>
                    <input type="number" id="lot-sale-price" step="0.01" onchange="calcLotProfit()">
                </div>
                <div class="form-group">
                    <label>Sale Date *</label>
                    <input type="date" id="lot-sale-date">
                </div>
                <div class="fee-section">
                    <h4>Fees</h4>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Sales Tax</label>
                            <input type="number" id="lot-tax" step="0.01" value="0" onchange="calcLotProfit()">
                        </div>
                        <div class="form-group">
                            <label>Shipping</label>
                            <input type="number" id="lot-shipping" step="0.01" value="0" onchange="calcLotProfit()">
                        </div>
                        <div class="form-group">
                            <label>Sale Fee</label>
                            <input type="number" id="lot-fee" step="0.01" value="0" onchange="calcLotProfit()">
                        </div>
                    </div>
                </div>
                <div style="background: #fff3e0; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                    <div class="card-detail">Net Sale: <strong id="lot-net">$0</strong></div>
                    <div class="card-detail">Profit: <strong id="lot-profit">$0</strong></div>
                    <div class="card-detail">ROI: <strong id="lot-roi">0%</strong></div>
                </div>
                <button class="btn btn-success" onclick="completeLotSale()">Complete Sale</button>
            </div>
        </div>
    </div>

    <div id="inventory" class="tab-content">
        <h2>All Cards</h2>
        <div class="search-box">
            <input type="text" id="search-input" placeholder="Search..." onkeyup="filterInventory()">
        </div>
        <div class="filter-section">
            <select id="filter-status" onchange="filterInventory()">
                <option value="">All Statuses</option>
                <option value="inventory">Inventory</option>
                <option value="grading">Grading</option>
                <option value="sold">Sold</option>
            </select>
            <button class="btn btn-secondary" onclick="exportData()">Export Data</button>
        </div>
        <div id="cards-container" class="card-grid"></div>
    </div>

    <div id="settings" class="tab-content">
        <h2>Settings</h2>
        
        <div style="background: white; padding: 25px; border-radius: 8px; margin-bottom: 20px; border: 2px solid #dee2e6;">
            <h3 style="margin-bottom: 20px;">🔥 Firebase Cloud Sync</h3>
            <p style="margin-bottom: 15px; color: #6c757d;">Connect to Firebase to sync your data across all devices.</p>
            <div id="firebase-status" style="margin-bottom: 15px;"></div>
            <button class="btn btn-success" onclick="connectFirebase()">Connect Firebase</button>
            <button class="btn btn-secondary" onclick="syncNow()">Sync Now</button>
        </div>

        <div style="background: white; padding: 25px; border-radius: 8px; border: 2px solid #dee2e6;">
            <h3 style="margin-bottom: 20px;">💾 Data Management</h3>
            <button class="btn btn-secondary" onclick="exportData()">Export All Data</button>
            <p style="margin-top: 15px; color: #6c757d;">Total Cards: <strong id="total-cards">0</strong></p>
        </div>
    </div>
</div>

<div id="sell-modal" class="modal">
    <div class="modal-content">
        <h2>Sell Card</h2>
        <form id="sell-form" onsubmit="return completeSingleSale(event)">
            <input type="hidden" id="sell-card-id">
            <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                <h3 id="sell-modal-name" style="color: #ff6b35;"></h3>
                <div class="card-detail">Cost: <strong id="sell-modal-cost">$0</strong></div>
            </div>
            <div class="form-group">
                <label>Sale Price *</label>
                <input type="number" id="sell-price" step="0.01" required onchange="calcSingleProfit()">
            </div>
            <div class="form-group">
                <label>Sale Date *</label>
                <input type="date" id="sell-date" required>
            </div>
            <div class="fee-section">
                <h4>Fees</h4>
                <div class="form-row">
                    <div class="form-group">
                        <label>Sales Tax</label>
                        <input type="number" id="single-tax" step="0.01" value="0" onchange="calcSingleProfit()">
                    </div>
                    <div class="form-group">
                        <label>Shipping</label>
                        <input type="number" id="single-shipping" step="0.01" value="0" onchange="calcSingleProfit()">
                    </div>
                    <div class="form-group">
                        <label>Sale Fee</label>
                        <input type="number" id="single-fee" step="0.01" value="0" onchange="calcSingleProfit()">
                    </div>
                </div>
            </div>
            <div style="background: #fff3e0; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                <div class="card-detail">Net Sale: <strong id="single-net">$0</strong></div>
                <div class="card-detail">Profit: <strong id="single-profit">$0</strong></div>
                <div class="card-detail">ROI: <strong id="single-roi">0%</strong></div>
            </div>
            <button type="submit" class="btn btn-success">Complete Sale</button>
            <button type="button" class="btn btn-secondary" onclick="closeSellModal()">Cancel</button>
        </form>
    </div>
</div>

<div id="edit-modal" class="modal">
    <div class="modal-content">
        <h2>Edit Card</h2>
        <form id="edit-form" onsubmit="return saveEdit(event)">
            <input type="hidden" id="edit-id">
            <div class="form-group">
                <label>Card Name *</label>
                <input type="text" id="edit-name" required>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Grade *</label>
                    <input type="text" id="edit-grade" required>
                </div>
                <div class="form-group">
                    <label>Purchase Price *</label>
                    <input type="number" id="edit-price" step="0.01" required>
                </div>
            </div>
            <div class="form-group">
                <label>Grading Fee</label>
                <input type="number" id="edit-grading-fee" step="0.01" value="0">
            </div>
            <div class="form-group">
                <label>Status *</label>
                <select id="edit-status" required>
                    <option value="inventory">Inventory</option>
                    <option value="grading">Grading</option>
                    <option value="sold">Sold</option>
                </select>
            </div>
            <div class="form-group">
                <label>Notes</label>
                <textarea id="edit-notes"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
        </form>
    </div>
</div>

<script>
    let cards = [];
    let bulkLot = [];
    let selectedLot = [];

    function loadCards() {
        const stored = localStorage.getItem('sbSportsCards');
        if (stored) {
            cards = JSON.parse(stored);
        }
    }

    function saveCards() {
        localStorage.setItem('sbSportsCards', JSON.stringify(cards));
        updateDashboard();
    }

    function switchTab(tabName) {
        const tabs = document.querySelectorAll('.tab');
        const contents = document.querySelectorAll('.tab-content');
        
        tabs.forEach(t => t.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));
        
        event.target.classList.add('active');
        document.getElementById(tabName).classList.add('active');

        if (tabName === 'dashboard') {
            displayRecent();
        } else if (tabName === 'inventory') {
            filterInventory();
        } else if (tabName === 'sell-card') {
            filterSellCards();
            filterLotSellCards();
        } else if (tabName === 'analytics') {
            updateAnalytics();
        }
    }

    function setMode(mode) {
        document.querySelectorAll('#add-card .mode-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('#add-card .form-section').forEach(s => s.classList.remove('active'));
        
        event.target.classList.add('active');
        document.getElementById(mode + '-mode').classList.add('active');
    }

    function setSellMode(mode) {
        document.querySelectorAll('#sell-card .mode-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('#sell-card .form-section').forEach(s => s.classList.remove('active'));
        
        event.target.classList.add('active');
        document.getElementById('sell-' + mode + '-mode').classList.add('active');
    }

    function addSingleCard(e) {
        e.preventDefault();
        
        const price = parseFloat(document.getElementById('card-purchase-price').value);
        const gradingFee = parseFloat(document.getElementById('card-grading-fee').value) || 0;
        
        cards.push({
            id: Date.now(),
            name: document.getElementById('card-name').value,
            grade: document.getElementById('card-grade').value,
            purchasePrice: price,
            gradingFee: gradingFee,
            totalCost: price + gradingFee,
            purchasedFrom: document.getElementById('card-purchased-from').value,
            purchaseDate: document.getElementById('card-purchase-date').value,
            status: document.getElementById('card-status').value,
            notes: document.getElementById('card-notes').value,
            dateAdded: new Date().toISOString()
        });
        
        saveCards();
        document.getElementById('single-card-form').reset();
        alert('Card added!');
        return false;
    }

    function addToBulkLot(e) {
        e.preventDefault();
        
        bulkLot.push({
            name: document.getElementById('bulk-card-name').value,
            grade: document.getElementById('bulk-card-grade').value
        });
        
        document.getElementById('bulk-card-form').reset();
        updateBulkPreview();
        return false;
    }

    function updateBulkPreview() {
        document.getElementById('lot-count').textContent = bulkLot.length;
        document.getElementById('lot-cards-list').innerHTML = bulkLot.map((c, i) => 
            `<div style="padding: 10px; border: 1px solid #ddd; margin: 5px 0; border-radius: 6px;">
                <strong>${c.name}</strong> - ${c.grade}
                <button onclick="removeFromBulk(${i})" class="btn btn-danger" style="float: right; padding: 5px 10px;">Remove</button>
            </div>`
        ).join('');
        
        document.getElementById('save-lot-btn').style.display = bulkLot.length > 0 ? 'block' : 'none';
    }

    function removeFromBulk(index) {
        bulkLot.splice(index, 1);
        updateBulkPreview();
    }

    function saveBulkLot() {
        const lotName = document.getElementById('lot-name').value;
        const totalPrice = parseFloat(document.getElementById('lot-purchase-price').value);
        const from = document.getElementById('lot-purchased-from').value;
        
        if (!lotName || !totalPrice || bulkLot.length === 0) {
            alert('Please fill in lot details and add cards');
            return;
        }
        
        const costPerCard = totalPrice / bulkLot.length;
        const now = new Date().toISOString();
        
        bulkLot.forEach(card => {
            cards.push({
                id: Date.now() + Math.random(),
                name: card.name,
                grade: card.grade,
                purchasePrice: costPerCard,
                gradingFee: 0,
                totalCost: costPerCard,
                purchasedFrom: from,
                lotName: lotName,
                status: 'inventory',
                dateAdded: now
            });
        });
        
        saveCards();
        bulkLot = [];
        document.getElementById('lot-name').value = '';
        document.getElementById('lot-purchase-price').value = '';
        document.getElementById('lot-purchased-from').value = '';
        updateBulkPreview();
        alert('Lot saved!');
    }

    function updateDashboard() {
        const inv = cards.filter(c => c.status === 'inventory').length;
        const grad = cards.filter(c => c.status === 'grading').length;
        const sold = cards.filter(c => c.status === 'sold').length;
        
        document.getElementById('stat-inventory').textContent = inv;
        document.getElementById('stat-grading').textContent = grad;
        document.getElementById('stat-sold').textContent = sold;
    }

    function displayRecent() {
        const recent = cards.slice(-6).reverse();
        const html = recent.map(c => createCardHTML(c)).join('');
        document.getElementById('recent-cards').innerHTML = html || '<p>No cards yet</p>';
    }

    function createCardHTML(card) {
        const profit = card.soldPrice ? (card.soldPrice - card.totalCost).toFixed(2) : null;
        
        return `
            <div class="card-item">
                <span class="card-status status-${card.status}">${card.status}</span>
                <h3>${card.name}</h3>
                <div class="card-detail"><strong>Grade:</strong> ${card.grade}</div>
                <div class="card-detail"><strong>Cost:</strong> $${card.totalCost.toFixed(2)}</div>
                ${card.soldPrice ? `<div class="card-detail"><strong>Sold:</strong> $${card.soldPrice}</div>` : ''}
                ${profit ? `<div class="card-detail" style="color: ${profit >= 0 ? 'green' : 'red'};"><strong>Profit:</strong> $${profit}</div>` : ''}
                <div class="card-actions">
                    <button class="btn btn-primary" onclick="openEdit(${card.id})">Edit</button>
                    <button class="btn btn-danger" onclick="deleteCard(${card.id})">Delete</button>
                </div>
            </div>
        `;
    }

    function filterInventory() {
        const search = document.getElementById('search-input').value.toLowerCase();
        const status = document.getElementById('filter-status').value;
        
        const filtered = cards.filter(c => {
            const matchSearch = c.name.toLowerCase().includes(search);
            const matchStatus = !status || c.status === status;
            return matchSearch && matchStatus;
        });
        
        document.getElementById('cards-container').innerHTML = 
            filtered.map(c => createCardHTML(c)).join('') || '<p>No cards found</p>';
    }

    function openEdit(id) {
        const card = cards.find(c => c.id === id);
        if (!card) return;
        
        document.getElementById('edit-id').value = card.id;
        document.getElementById('edit-name').value = card.name;
        document.getElementById('edit-grade').value = card.grade;
        document.getElementById('edit-price').value = card.purchasePrice;
        document.getElementById('edit-grading-fee').value = card.gradingFee || 0;
        document.getElementById('edit-status').value = card.status;
        document.getElementById('edit-notes').value = card.notes || '';
        
        document.getElementById('edit-modal').classList.add('active');
    }

    function closeEditModal() {
        document.getElementById('edit-modal').classList.remove('active');
    }

    function saveEdit(e) {
        e.preventDefault();
        
        const id = parseInt(document.getElementById('edit-id').value);
        const index = cards.findIndex(c => c.id === id);
        
        if (index !== -1) {
            const price = parseFloat(document.getElementById('edit-price').value);
            const gradingFee = parseFloat(document.getElementById('edit-grading-fee').value) || 0;
            
            cards[index].name = document.getElementById('edit-name').value;
            cards[index].grade = document.getElementById('edit-grade').value;
            cards[index].purchasePrice = price;
            cards[index].gradingFee = gradingFee;
            cards[index].totalCost = price + gradingFee;
            cards[index].status = document.getElementById('edit-status').value;
            cards[index].notes = document.getElementById('edit-notes').value;
            
            saveCards();
            closeEditModal();
            filterInventory();
            alert('Card updated!');
        }
        
        return false;
    }

    function deleteCard(id) {
        if (confirm('Delete this card?')) {
            cards = cards.filter(c => c.id !== id);
            saveCards();
            filterInventory();
            displayRecent();
        }
    }

    function filterSellCards() {
        const search = document.getElementById('sell-search').value.toLowerCase();
        const available = cards.filter(c => c.status !== 'sold' && c.name.toLowerCase().includes(search));
        
        document.getElementById('sell-cards-container').innerHTML = available.map(c => `
            <div style="padding: 15px; border: 2px solid #ddd; margin: 10px 0; border-radius: 8px;">
                <strong>${c.name}</strong> - ${c.grade}<br>
                <small>Cost: $${c.totalCost.toFixed(2)}</small>
                <button class="btn btn-primary" onclick="openSellModal(${c.id})" style="float: right;">Sell</button>
            </div>
        `).join('') || '<p>No cards available</p>';
    }

    function openSellModal(id) {
        const card = cards.find(c => c.id === id);
        if (!card) return;
        
        document.getElementById('sell-card-id').value = card.id;
        document.getElementById('sell-modal-name').textContent = card.name;
        document.getElementById('sell-modal-cost').textContent = '$' + card.totalCost.toFixed(2);
        document.getElementById('sell-date').value = new Date().toISOString().split('T')[0];
        
        document.getElementById('sell-modal').classList.add('active');
    }

    function closeSellModal() {
        document.getElementById('sell-modal').classList.remove('active');
    }

    function calcSingleProfit() {
        const price = parseFloat(document.getElementById('sell-price').value) || 0;
        const tax = parseFloat(document.getElementById('single-tax').value) || 0;
        const shipping = parseFloat(document.getElementById('single-shipping').value) || 0;
        const fee = parseFloat(document.getElementById('single-fee').value) || 0;
        
        const id = parseInt(document.getElementById('sell-card-id').value);
        const card = cards.find(c => c.id === id);
        if (!card) return;
        
        const net = price - tax - shipping - fee;
        const profit = net - card.totalCost;
        const roi = card.totalCost > 0 ? ((profit / card.totalCost) * 100) : 0;
        
        document.getElementById('single-net').textContent = '$' + net.toFixed(2);
        document.getElementById('single-profit').textContent = '$' + profit.toFixed(2);
        document.getElementById('single-profit').style.color = profit >= 0 ? 'green' : 'red';
        document.getElementById('single-roi').textContent = roi.toFixed(1) + '%';
    }

    function completeSingleSale(e) {
        e.preventDefault();
        
        const id = parseInt(document.getElementById('sell-card-id').value);
        const index = cards.findIndex(c => c.id === id);
        
        if (index !== -1) {
            const price = parseFloat(document.getElementById('sell-price').value);
            const tax = parseFloat(document.getElementById('single-tax').value) || 0;
            const shipping = parseFloat(document.getElementById('single-shipping').value) || 0;
            const fee = parseFloat(document.getElementById('single-fee').value) || 0;
            
            cards[index].soldPrice = price - tax - shipping - fee;
            cards[index].soldDate = document.getElementById('sell-date').value;
            cards[index].salesTax = tax;
            cards[index].shippingFee = shipping;
            cards[index].saleFee = fee;
            cards[index].status = 'sold';
            
            saveCards();
            closeSellModal();
            filterSellCards();
            alert('Card sold!');
        }
        
        return false;
    }

    function filterLotSellCards() {
        const search = document.getElementById('lot-sell-search').value.toLowerCase();
        const available = cards.filter(c => c.status !== 'sold' && c.name.toLowerCase().includes(search));
        
        document.getElementById('lot-sell-container').innerHTML = available.map(c => `
            <div class="checkbox-item ${selectedLot.includes(c.id) ? 'selected' : ''}" onclick="toggleLotSelection(${c.id})">
                <input type="checkbox" ${selectedLot.includes(c.id) ? 'checked' : ''} onclick="event.stopPropagation(); toggleLotSelection(${c.id})">
                <strong>${c.name}</strong> - ${c.grade} ($${c.totalCost.toFixed(2)})
            </div>
        `).join('') || '<p>No cards available</p>';
        
        updateLotSelection();
    }

    function toggleLotSelection(id) {
        const index = selectedLot.indexOf(id);
        if (index > -1) {
            selectedLot.splice(index, 1);
        } else {
            selectedLot.push(id);
        }
        filterLotSellCards();
    }

    function updateLotSelection() {
        document.getElementById('selected-count').textContent = selectedLot.length;
    }

    function calcLotProfit() {
        const price = parseFloat(document.getElementById('lot-sale-price').value) || 0;
        const tax = parseFloat(document.getElementById('lot-tax').value) || 0;
        const shipping = parseFloat(document.getElementById('lot-shipping').value) || 0;
        const fee = parseFloat(document.getElementById('lot-fee').value) || 0;
        
        let totalCost = 0;
        selectedLot.forEach(id => {
            const card = cards.find(c => c.id === id);
            if (card) totalCost += card.totalCost;
        });
        
        const net = price - tax - shipping - fee;
        const profit = net - totalCost;
        const roi = totalCost > 0 ? ((profit / totalCost) * 100) : 0;
        
        document.getElementById('lot-net').textContent = '$' + net.toFixed(2);
        document.getElementById('lot-profit').textContent = '$' + profit.toFixed(2);
        document.getElementById('lot-profit').style.color = profit >= 0 ? 'green' : 'red';
        document.getElementById('lot-roi').textContent = roi.toFixed(1) + '%';
    }

    function completeLotSale() {
        if (selectedLot.length === 0) {
            alert('Please select cards');
            return;
        }
        
        const price = parseFloat(document.getElementById('lot-sale-price').value);
        const date = document.getElementById('lot-sale-date').value;
        
        if (!price || !date) {
            alert('Please enter price and date');
            return;
        }
        
        const tax = parseFloat(document.getElementById('lot-tax').value) || 0;
        const shipping = parseFloat(document.getElementById('lot-shipping').value) || 0;
        const fee = parseFloat(document.getElementById('lot-fee').value) || 0;
        
        const net = price - tax - shipping - fee;
        const pricePerCard = net / selectedLot.length;
        
        selectedLot.forEach(id => {
            const index = cards.findIndex(c => c.id === id);
            if (index !== -1) {
                cards[index].soldPrice = pricePerCard;
                cards[index].soldDate = date;
                cards[index].salesTax = tax / selectedLot.length;
                cards[index].shippingFee = shipping / selectedLot.length;
                cards[index].saleFee = fee / selectedLot.length;
                cards[index].status = 'sold';
            }
        });
        
        saveCards();
        selectedLot = [];
        document.getElementById('lot-sale-price').value = '';
        document.getElementById('lot-tax').value = '0';
        document.getElementById('lot-shipping').value = '0';
        document.getElementById('lot-fee').value = '0';
        filterLotSellCards();
        alert('Lot sold!');
    }

    function updateAnalytics() {
        const timeframe = document.getElementById('analytics-timeframe').value;
        const now = new Date();
        let startDate = new Date(0);
        
        if (timeframe === 'today') {
            startDate = new Date(now.setHours(0,0,0,0));
        } else if (timeframe === 'week') {
            startDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
        } else if (timeframe === 'month') {
            startDate = new Date(now.getFullYear(), now.getMonth(), 1);
        } else if (timeframe === 'year') {
            startDate = new Date(now.getFullYear(), 0, 1);
        }
        
        const soldCards = cards.filter(c => {
            if (!c.soldDate) return false;
            return new Date(c.soldDate) >= startDate;
        });
        
        let revenue = 0;
        let expenses = 0;
        
        soldCards.forEach(c => {
            if (c.soldPrice) revenue += c.soldPrice;
            if (c.totalCost) expenses += c.totalCost;
        });
        
        const profit = revenue - expenses;
        const roi = expenses > 0 ? ((profit / expenses) * 100) : 0;
        
        document.getElementById('total-revenue').textContent = '$' + revenue.toFixed(2);
        document.getElementById('total-expenses').textContent = '$' + expenses.toFixed(2);
        document.getElementById('net-profit').textContent = '$' + profit.toFixed(2);
        document.getElementById('roi-percentage').textContent = roi.toFixed(1) + '%';
        
        document.getElementById('total-sales-count').textContent = soldCards.length;
        
        if (soldCards.length > 0) {
            const avg = revenue / soldCards.length;
            const prices = soldCards.map(c => c.soldPrice).filter(p => p);
            const highest = Math.max(...prices);
            
            document.getElementById('avg-sale-price').textContent = '$' + avg.toFixed(2);
            document.getElementById('highest-sale').textContent = '$' + highest.toFixed(2);
        }
        
        const inv = cards.filter(c => c.status === 'inventory');
        let invCost = 0;
        inv.forEach(c => invCost += c.totalCost);
        
        document.getElementById('current-inventory-count').textContent = inv.length;
        document.getElementById('total-invested').textContent = '$' + invCost.toFixed(2);
    }

    function exportData() {
        const dataStr = JSON.stringify(cards, null, 2);
        const blob = new Blob([dataStr], {type: 'application/json'});
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'sb-sports-cards-' + new Date().toISOString().split('T')[0] + '.json';
        link.click();
        URL.revokeObjectURL(url);
    }

    window.onclick = function(event) {
        if (event.target.classList.contains('modal')) {
            event.target.classList.remove('active');
        }
    }

    // Firebase Integration
    let db = null;
    let isFirebaseConnected = false;

    function connectFirebase() {
        const script1 = document.createElement('script');
        script1.src = 'https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js';
        document.head.appendChild(script1);

        script1.onload = function() {
            const script2 = document.createElement('script');
            script2.src = 'https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js';
            document.head.appendChild(script2);

            script2.onload = function() {
                initFirebase();
            };
        };
    }

    function initFirebase() {
        const config = {
            apiKey: "AIzaSyBkAHH-m3__HxAeqJj_qYsGK4xe7ZHUhS8",
            authDomain: "sb-sports-cards.firebaseapp.com",
            projectId: "sb-sports-cards",
            storageBucket: "sb-sports-cards.firebasestorage.app",
            messagingSenderId: "662250964894",
            appId: "1:662250964894:web:f4bd0b7c21220d69f1788f"
        };

        try {
            if (!firebase.apps.length) {
                firebase.initializeApp(config);
            }
            db = firebase.firestore();
            isFirebaseConnected = true;
            
            document.getElementById('sync-dot').classList.remove('offline');
            document.getElementById('sync-text').textContent = 'Cloud Synced';
            document.getElementById('firebase-status').innerHTML = '<p style="color: #28a745;">✓ Connected to Firebase</p>';
            
            syncFromFirebase();
            
            setInterval(() => {
                if (isFirebaseConnected) {
                    syncToFirebase();
                }
            }, 30000);
            
            alert('Firebase connected! Data will sync across devices.');
        } catch (error) {
            console.error('Firebase error:', error);
            document.getElementById('firebase-status').innerHTML = '<p style="color: #dc3545;">✗ Connection failed</p>';
            alert('Could not connect to Firebase. Check console for details.');
        }
    }

    function syncToFirebase() {
        if (!isFirebaseConnected || !db) return;

        try {
            const batch = db.batch();
            cards.forEach(card => {
                const docRef = db.collection('cards').doc(String(card.id));
                batch.set(docRef, card, { merge: true });
            });
            batch.commit();
        } catch (error) {
            console.error('Sync error:', error);
        }
    }

    async function syncFromFirebase() {
        if (!isFirebaseConnected || !db) return;

        try {
            const snapshot = await db.collection('cards').get();
            if (!snapshot.empty) {
                const cloudCards = [];
                snapshot.forEach(doc => cloudCards.push(doc.data()));
                
                cloudCards.forEach(cloudCard => {
                    const exists = cards.find(c => c.id === cloudCard.id);
                    if (!exists) {
                        cards.push(cloudCard);
                    }
                });
                
                saveCards();
                updateDashboard();
                filterInventory();
            }
        } catch (error) {
            console.error('Sync from Firebase error:', error);
        }
    }

    function syncNow() {
        if (!isFirebaseConnected) {
            alert('Firebase not connected. Click "Connect Firebase" first.');
            return;
        }
        syncToFirebase();
        alert('Data synced to cloud!');
    }

    // Update total cards count
    function updateSettings() {
        document.getElementById('total-cards').textContent = cards.length;
    }

    loadCards();
    updateDashboard();
    displayRecent();
    updateSettings();
    
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('card-purchase-date').value = today;
</script>
